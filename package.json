{
	"name": "@gumlet/gif-resize",
	"version": "2.0.1",
	"description": "Nodejs plugin to resize GIFs",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gumlet/gif-resize.git"
	},
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run --coverage",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit"
	},
	"types": "dist/index.d.ts",
	"files": [
		"dist/*"
	],
	"main": "dist/index.js",
	"module": "dist/index.js",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"keywords": [
		"compress",
		"gif",
		"resize",
		"gifsicle",
		"gulpplugin",
		"image",
		"img",
		"minify",
		"optimize"
	],
	"dependencies": {
		"execa": "^9.0.0",
		"gifsicle": "^7.0.0"
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "^2.4.9",
		"@types/gifsicle": "^5.2.2",
		"@types/node": "^26.2.0",
		"@vitest/coverage-v8": "^4.1.1",
		"get-pixels": "^3.3.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.1"
	},
	"bugs": {
		"url": "https://github.com/gumlet/gif-resize/issues"
	},
	"homepage": "https://github.com/gumlet/gif-resize#readme",
	"directories": {
		"test": "tests"
	},
	"author": "Aditya Patadia"
}
